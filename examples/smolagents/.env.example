# Copy to examples/smolagents/.env, then fill in your DeepSeek API key locally.
# Official DeepSeek endpoint and model checked on 2026-10-04.
SMOL_MODEL_API_BASE=https://api.deepseek.com
SMOL_MODEL_ID=deepseek-flash
SMOL_MODEL_API_KEY=
# Optional target service authentication. See README before enabling.
# SMOL_SERVICE_TOKEN=your-target-access-token
