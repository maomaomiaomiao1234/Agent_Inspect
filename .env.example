# ==============================================================================
# Agent Trace Review 核心服务与存储配置
#
# 使用方法：
#   cp .env.example .env
#   chmod 600 .env
#   在 .env 中填写本机密钥后，执行 uv run agent-review serve。
#   serve 自动读取当前目录 .env；已有进程环境变量和显式 CLI 参数优先。
#
# .env 只保存在本机，严禁提交到 Git 或复制到 targets.json、题集、报告和网页。
# ==============================================================================
# 数据与 SQLite 存储目录 (默认: .agent-review)
AGENT_REVIEW_DATA=.agent-review

# 主动评测目标注册清单路径 (可选，例如: examples/assessment/targets.json)
AGENT_REVIEW_TARGETS=

# 服务访问令牌 (若监听 127.0.0.1 可留空；若通过局域网/公网访问必填)
AGENT_REVIEW_SERVICE_TOKEN=

# 允许访问的 Host 白名单 (默认包含 localhost, 127.0.0.1, [::1])，多个用英文逗号分隔
AGENT_REVIEW_ALLOWED_HOSTS=

# 网页启动配置（本机默认启用仓库构建；需要安装 Git 并启动 Docker）
AGENT_REVIEW_HOST=127.0.0.1
AGENT_REVIEW_PORT=8765
AGENT_REVIEW_ENABLE_REPOSITORY_BUILDS=true

# 网页仓库评测默认使用真实大模型；offline 仅用于无模型校准
AGENT_REVIEW_REPOSITORY_BACKEND=openai

# 评测默认参数，网页可修改。案例数 × 重复次数 × 期限不能超过 900 秒。
AGENT_REVIEW_ASSESSMENT_CASES=12
AGENT_REVIEW_ASSESSMENT_SEED=42
AGENT_REVIEW_ASSESSMENT_DEADLINE=60
AGENT_REVIEW_ASSESSMENT_MAX_OUTPUT_TOKENS=2048
AGENT_REVIEW_ASSESSMENT_ATTEMPTS=1
AGENT_REVIEW_ASSESSMENT_CONCURRENCY=1

# （可选）非模型运行变量白名单，用英文逗号分隔；模型变量已自动接入
AGENT_REVIEW_REPOSITORY_ENV=

# 未知 Python 仓库：用 LLM 生成接入代码，先验证原 Agent 入口再正式评测。
# 相关源码片段发送至下方 AGENT_REVIEW_LLM_* 配置的供应商；LLM 密钥留空时复用被测模型配置。
AGENT_REVIEW_AUTO_ADAPT=true
# 默认最多修复一次（0–2），网页可修改；最多生成 1 + 修复次数次。
AGENT_REVIEW_ADAPTATION_REPAIRS=1
# 输出上限留空或 auto：不发送 max_tokens/max_completion_tokens，由模型供应商决定输出长度。
# 如需主动限制可填写正整数；与被测 Agent 的正式评测预算分开。
AGENT_REVIEW_ADAPTATION_MAX_OUTPUT_TOKENS=
# 生成可能包含长思考过程，默认等待 900 秒；允许 0–3600 秒（不含 0）。
AGENT_REVIEW_ADAPTATION_TIMEOUT=900
AGENT_REVIEW_ADAPTATION_MAX_INPUT_CHARS=60000
# DeepSeek 适配器生成开启思考模式。
# 留空：使用供应商默认，不发送 thinking 参数；enabled/disabled 仅用于支持此参数的 API。
# 仅控制适配器生成，不改变被测 Agent 和 LLM 评审的模型参数。
AGENT_REVIEW_ADAPTATION_THINKING=enabled

# ==============================================================================
# LLM 智能评审配置 (用于对 Agent 轨迹和任务输出进行大模型定性评审)
# ==============================================================================
# 兼容 OpenAI 格式的 API 基础端点 (如 DeepSeek, OpenAI, Ollama, 通义千问等)
AGENT_REVIEW_LLM_API_URL=https://api.deepseek.com

# 评审使用的大模型名称 (DeepSeek 当前示例使用 deepseek-flash)
AGENT_REVIEW_LLM_MODEL=deepseek-flash

# 访问大模型的 API Key / Token
AGENT_REVIEW_LLM_TOKEN=

# 控制最大输出 Token 的参数名 (大部分模型为 max_tokens，部分模型如 o1 为 max_completion_tokens)
AGENT_REVIEW_LLM_TOKEN_PARAMETER=max_tokens

# ==============================================================================
# 被测 Agent 模型配置 (针对 smolagents 示例或 Docker 评测时向容器传递的变量)
# ==============================================================================
SMOL_MODEL_API_BASE=https://api.deepseek.com
SMOL_MODEL_ID=deepseek-flash
SMOL_MODEL_API_KEY=

# （可选）专门为网页评测配置模型，优先于 SMOL_MODEL_* 和 AGENT_REVIEW_LLM_*。
# 全部留空：优先使用有密钥的 SMOL_MODEL_*；否则复用 AGENT_REVIEW_LLM_*。
# 填写此组时需要三项齐全，不会混用其他组的 URL、模型或密钥。
AGENT_REVIEW_TARGET_API_URL=
AGENT_REVIEW_TARGET_MODEL=
AGENT_REVIEW_TARGET_TOKEN=

# (可选) 目标 Agent 服务令牌
# SMOL_SERVICE_TOKEN=

# ==============================================================================
# 早期 Inspect Scout Judge 评审配置 (可选)
# ==============================================================================
AGENT_REVIEW_JUDGE_MODEL=
AGENT_REVIEW_JUDGE_BASE_URL=
